# ===================================
# REQUIRED ENVIRONMENT VARIABLES
# ===================================

# MongoDB connection string
# Get this from MongoDB Atlas or use local: mongodb://localhost:27017/streamofconshushness
MONGODB_URI="your_mongodb_atlas_connection_string_here"

# JWT secret for token signing (production requires 32+ characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your_super_secret_jwt_key_here"

# Server port
PORT=3000

# ===================================
# OPTIONAL ENVIRONMENT VARIABLES
# ===================================

# Environment mode (development, production, test)
NODE_ENV=development

# Frontend origin for CORS (development: http://localhost:5173, production: your-domain.com)
CLIENT_ORIGIN=http://localhost:5173

# Base URL for the application (used in password reset emails)
APP_BASE_URL=http://localhost:3000

# Number of trusted reverse-proxy hops. Keep 0 when the Node server is
# directly exposed; use 1 only when exactly one trusted proxy sits in front.
TRUST_PROXY_HOPS=0

# Production must point this at an absolute path on a persistent volume.
# PRIVATE_UPLOAD_DIR=/var/lib/streamofconshushness/private-uploads

# Local-only escape hatch for showing reset/verification credentials in the UI.
# Keep false unless you explicitly need it on a private development machine.
EXPOSE_AUTH_TEST_CREDENTIALS=false

# Development-only route inventory. Leave disabled unless actively debugging.
EXPOSE_ROUTE_INSPECTOR=false

# ===================================
# EMAIL CONFIGURATION (Optional)
# ===================================
# Required for password reset emails
# Leave commented out if not using email features

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourapp.com

# ===================================
# ADMIN CONFIGURATION (Optional)
# ===================================
# Secret for admin-only operations (e.g., /api/admin/reset-user-password)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"

# ADMIN_SECRET=your_admin_secret_here
